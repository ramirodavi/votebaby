# =============================================================================
# votebaby — modelo de variáveis de ambiente
# =============================================================================
# Como usar: copie este arquivo para ".env" na pasta backend e preencha os
# valores. O arquivo ".env" não deve ser commitado (já está no .gitignore).
# Se credenciais já vazaram no git no passado, gere nova senha no provedor.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL — ex.: Neon)
# Usado em: backend/db.js para conectar ao servidor SQL.
# -----------------------------------------------------------------------------
# Usuário da base (no Neon costuma terminar em _owner).
PG_USER=

# Host do servidor PostgreSQL (hostname do pooler, sem https://).
PG_HOST=

# Nome da base de dados.
PG_DATABASE=

# Senha do usuário acima. Mantenha secreta.
PG_PASSWORD=

# Porta do PostgreSQL (padrão 5432).
PG_PORT=5432

# -----------------------------------------------------------------------------
# Servidor Node e segurança
# -----------------------------------------------------------------------------
# Ambiente de execução do Node. Afeta:
# - Conexão com o banco: em "production" usa SSL (necessário em Neon/Render);
#   em "development" ou outros valores, SSL fica desligado (útil no PC local).
NODE_ENV=development

# Endereço do site onde o frontend está hospedado (só protocolo + domínio,
# sem barra no final). O Express usa isso no CORS para aceitar chamadas do
# navegador. Exemplos: http://127.0.0.1:5500 (Live Server), ou
# https://seu-usuario.github.io no GitHub Pages.
# O GET /config devolve "apiUrl" sozinho (mesmo host/protocolo do pedido ao backend).
FRONTEND_URL=http://127.0.0.1:5500

# Porta onde o processo Node escuta (HTTP + WebSocket).
# - No Render normalmente fica vazio: a plataforma define a porta automaticamente.
# - No PC: use 3000 ou outra livre; se vazio, o código assume 3000 onde aplicável.
PORT=

# -----------------------------------------------------------------------------
# Textos e resultado do “chá revelação”
# Enviados pelo GET /config para o frontend montar títulos e a faixa de revelação.
# -----------------------------------------------------------------------------
# Nome exibido para o lado “menino” na votação e contadores.
BABY_BOY_NAME=Menino

# Nome exibido para o lado “menina”.
BABY_GIRL_NAME=Menina

# Resultado já revelado: "boy" (menino), "girl" (menina) ou "pending" (ainda não
# revelou — mostra formulário de voto e comentários).
REVEAL_RESULT=pending

# Frase extra abaixo do título na faixa de revelação (quando não é "pending").
REVEAL_TEXT=

# Depois da revelação, os convidados ainda podem deixar comentários (recados)?
# true = o formulário continua aberto ("Deixe um recado para o bebê").
# false (padrão) = o formulário some e o servidor recusa comentários novos.
ALLOW_COMMENTS_AFTER_REVEAL=false

# -----------------------------------------------------------------------------
# Cores do tema (formato CSS, ex.: rgb(58, 177, 98))
# Todas vão no GET /config; o frontend aplica como variáveis CSS.
# -----------------------------------------------------------------------------
# Cor principal dos botões e elementos “menino”.
BOY_COLOR=rgb(58, 177, 98)

# Cor de fundo suave associada ao tema menino (gradiente da página).
BG_BOY_COLOR=rgb(172, 241, 197)

# Cor principal dos elementos “menina”.
GIRL_COLOR=rgb(219, 130, 207)

# Cor de fundo suave do tema menina.
BG_GIRL_COLOR=rgb(231, 179, 223)

# Cor dos balões na animação quando o resultado é menino.
BALLOON_BOY_COLOR=rgb(95, 192, 171)

# Cor dos balões quando o resultado é menina.
BALLOON_GIRL_COLOR=rgb(201, 125, 236)

# Cor de fundo da faixa grande de revelação (quando o resultado é menino).
REVEAL_BG_BOY_COLOR=rgb(108, 216, 148)

# Cor de fundo da faixa de revelação (quando o resultado é menina).
REVEAL_BG_GIRL_COLOR=rgb(219, 130, 207)

# -----------------------------------------------------------------------------
# Comportamento da página
# -----------------------------------------------------------------------------
# true = após a revelação, a página faz scroll automático para cima e para baixo.
# false = scroll só manual.
ENABLE_AUTO_SCROLL=false
